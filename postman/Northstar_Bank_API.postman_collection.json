{
  "info": {
    "name": "Northstar Bank — Banking Management System API",
    "description": "Complete Postman collection covering authentication, customer banking, transfers, statements, and admin controls.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "accountId", "value": "1" },
    { "key": "receiverAccountNumber", "value": "NB000000000002" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{accessToken}}", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Kavya Nair\",\n  \"email\": \"kavya.nair@example.com\",\n  \"password\": \"StrongPass@2026!\",\n  \"phone\": \"+91 9876501234\",\n  \"address\": \"42 Indiranagar, Bengaluru\",\n  \"pan\": \"KAVYA1234N\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"aarav.sharma@northstarbank.com\",\n  \"password\": \"Customer@Bank2026!\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/refresh"
          }
        },
        {
          "name": "Current User (/me)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Customer Banking",
      "item": [
        {
          "name": "Open Account",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.id) {",
                  "  pm.collectionVariables.set('accountId', json.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"SAVINGS\"\n}"
            },
            "url": "{{baseUrl}}/api/accounts"
          }
        },
        {
          "name": "List My Accounts",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/accounts"
          }
        },
        {
          "name": "Deposit",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 2500.00,\n  \"description\": \"Postman cash deposit\"\n}"
            },
            "url": "{{baseUrl}}/api/accounts/{{accountId}}/deposit"
          }
        },
        {
          "name": "Withdraw",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 500.00,\n  \"description\": \"Postman withdrawal\"\n}"
            },
            "url": "{{baseUrl}}/api/accounts/{{accountId}}/withdraw"
          }
        },
        {
          "name": "Transfer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromAccountId\": {{accountId}},\n  \"toAccountNumber\": \"{{receiverAccountNumber}}\",\n  \"amount\": 300.00,\n  \"description\": \"Invoice transfer\"\n}"
            },
            "url": "{{baseUrl}}/api/transfers"
          }
        },
        {
          "name": "Account Statement",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/accounts/{{accountId}}/transactions?page=0&size=10"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Admin Customer Listing",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/customers"
          }
        },
        {
          "name": "Admin Account Listing",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/accounts"
          }
        },
        {
          "name": "Freeze Account",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"FROZEN\"\n}"
            },
            "url": "{{baseUrl}}/api/admin/accounts/{{accountId}}/status"
          }
        },
        {
          "name": "Filter Admin Transactions",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/transactions?type=DEPOSIT&page=0&size=20"
          }
        }
      ]
    }
  ]
}
